    {
      "name": "2. Flujo principal (integracion)",
      "item": [
        {
          "name": "GET Restaurantes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Body es un array con restaurantes\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "});",
                  "pm.test(\"Incluye Taqueria Don Pepe (dato fijo conocido)\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const nombres = jsonData.map(r => r.name);",
                  "    pm.expect(nombres.join(',')).to.include('Don Pepe');",
                  "});",
                  "pm.test(\"Guardar restaurantId\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.environment.set('restaurantId', jsonData[0].id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/restaurants", "host": ["{{base_url}}"], "path": ["api", "restaurants"] }
          },
          "response": []
        },
        {
          "name": "GET Menu de restaurante",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Body tiene restaurant y menu\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('restaurant');",
                  "    pm.expect(jsonData).to.have.property('menu');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/restaurants/{{restaurantId}}/menu", "host": ["{{base_url}}"], "path": ["api", "restaurants", "{{restaurantId}}", "menu"] }
          },
          "response": []
        },
        {
          "name": "POST Crear usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Body devuelve el usuario creado\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.email).to.eql('qa.finlab@example.com');",
                  "});",
                  "pm.test(\"Guardar userId\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.environment.set('userId', jsonData.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Usuario de Prueba QA\",\n    \"email\": \"qa.finlab@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/users", "host": ["{{base_url}}"], "path": ["api", "users"] }
          },
          "response": []
        },
        {
          "name": "POST Crear orden",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Body devuelve la orden creada\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(Number(jsonData.total)).to.eql(3);",
                  "});",
                  "pm.test(\"Guardar orderId\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.environment.set('orderId', jsonData.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_id\": {{userId}},\n    \"total\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api", "orders"] }
          },
          "response": []
