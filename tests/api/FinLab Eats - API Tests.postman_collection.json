    {
      "name": "4. Seguridad (hallazgo real)",
      "item": [
        {
          "name": "POST Orden con userId inexistente (sin validacion de autorizacion)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HALLAZGO: el backend acepta un userId que no existe (201), sin validar que el usuario sea real ni que quien manda el request sea ese usuario\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Esto documenta ausencia de control de acceso: cualquiera puede crear ordenes a nombre de cualquier userId\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(String(jsonData.user_id)).to.eql('999999');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_id\": 999999,\n    \"total\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api", "orders"] }
          },
          "response": []
        }
      ]
    }
