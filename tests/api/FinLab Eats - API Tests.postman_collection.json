          "response": []
        },
        {
          "name": "GET Verificar orden en consulta (regresion)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"La orden creada aparece al consultar despues (no solo en el POST)\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const orderId = pm.environment.get('orderId');",
                  "    const existe = jsonData.some(o => String(o.id) === String(orderId));",
                  "    pm.expect(existe).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api", "orders"] }
          },
          "response": []
        },
        {
          "name": "GET Verificar pago en consulta (regresion)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"El pago creado aparece al consultar despues\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const orderId = pm.environment.get('orderId');",
                  "    const existe = jsonData.some(p => String(p.order_id) === String(orderId));",
                  "    pm.expect(existe).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/payments", "host": ["{{base_url}}"], "path": ["api", "payments"] }
          },
          "response": []
